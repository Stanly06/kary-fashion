# --- Base de datos (Supabase → Project Settings → Database → Connection string, modo "Session") ---
DATABASE_URL=postgres://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Inicio de sesión ---
# supabase: correo y contraseña con Supabase Auth (producción)
# dev:      selector de usuarias de prueba (SOLO desarrollo local; se bloquea en Vercel)
AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Sin DATABASE_URL el panel funciona en modo demostración (datos de ejemplo, sin inicio de sesión).

# --- Tienda online: fotos de productos ---
# Producción: las fotos se guardan en Supabase Storage (cree un bucket público llamado «productos»).
# La clave «service_role» está en Supabase → Project Settings → API. Nunca la comparta ni la ponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: quitar el fondo de las fotos con IA (remove.bg, se paga por foto). Sin esta clave esa opción queda desactivada.
REMOVE_BG_API_KEY=
